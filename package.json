{
  "name": "@nombaoss/openapi",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI specification for the Nomba API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NombaOSS/openapi.git"
  },
  "scripts": {
    "sync": "node scripts/sync-from-docs.mjs",
    "lint": "redocly lint nomba",
    "bundle": "redocly bundle nomba -o dist/openapi.yaml && redocly bundle nomba -o dist/openapi.json",
    "docs": "redocly build-docs nomba -o dist/index.html",
    "stats": "redocly stats nomba"
  },
  "devDependencies": {
    "@redocly/cli": "2.73.0",
    "yaml": "2.9.1"
  }
}
